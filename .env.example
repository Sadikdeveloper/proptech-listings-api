# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=log

# Database (required - the app refuses to boot without it)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proptech?schema=public"
# Size of the PostgreSQL connection pool created by the driver adapter
DATABASE_CONNECTION_LIMIT=10

# Comma separated list of allowed browser origins, or "*" to reflect any origin
# (handy for preview environments - restrict it in production)
CORS_ORIGINS=*

# Swagger UI is disabled automatically when NODE_ENV=production unless set to true
SWAGGER_ENABLED=true
