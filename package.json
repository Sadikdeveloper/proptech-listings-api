{
  "name": "proptech-listings-api",
  "version": "1.0.0",
  "description": "Property listings API (NestJS + Prisma + PostgreSQL) with geo search",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "test": "node scripts/test-runner.js --runInBand",
    "test:unit": "node scripts/test-runner.js --runInBand --testPathPatterns=test/unit",
    "test:e2e": "node scripts/test-runner.js --runInBand --testPathPatterns=test/e2e",
    "typecheck": "tsc --noEmit",
    "db:apply": "node scripts/apply-migrations.js",
    "db:embedded": "node scripts/embedded-postgres.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@prisma/prisma-schema-wasm": "^7.1.1-3.c2990dca591cba766e3b7ef5d9e8a84796e47ab7",
    "@prisma/schema-engine-wasm": "^7.1.1-3.c2990dca591cba766e3b7ef5d9e8a84796e47ab7",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "^17.10.0-beta.17",
    "jest": "^30.1.3",
    "pg": "^8.23.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
